# LingoQuest AI - Configurações de Ambiente
# Renomeie este arquivo para .env e preencha a chave abaixo na sua VM.

# Chave API obtida gratuitamente no Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Porta de execução do servidor Express (opcional, padrão: 8000)
PORT=8000
